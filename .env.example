# Copy to .env and adjust. `bun run db:start` provisions a local Postgres
# matching these defaults, so the values below work out of the box.
DATABASE_URL=postgres://relay:relay@localhost:5433/relay

API_PORT=4000
API_HOST=127.0.0.1

# Origin allowed to send credentialed requests to the API.
WEB_ORIGIN=http://localhost:3000

# Set to 1 in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=0

REALTIME_PORT=4001

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001/ws
