{
  "name": "relay",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/fix-pg-dylibs.ts",
    "db:start": "bun run scripts/dev-db.ts start",
    "db:stop": "bun run scripts/dev-db.ts stop",
    "db:reset": "bun run scripts/dev-db.ts reset",
    "db:push": "bun --filter '@relay/database' push",
    "db:seed": "bun run scripts/seed.ts",
    "dev:api": "bun --watch apps/api/src/main.ts",
    "dev:web": "bun --filter '@relay/web' dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/auth && tsc --noEmit -p packages/database && tsc --noEmit -p packages/sync && tsc --noEmit -p apps/api && tsc --noEmit -p apps/realtime",
    "start:api": "bun apps/api/src/main.ts",
    "grant:owner": "bun run scripts/grant-owner.ts",
    "dev:realtime": "bun --watch apps/realtime/src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@relay/api": "workspace:*",
    "@relay/auth": "workspace:*",
    "@relay/database": "workspace:*",
    "@relay/realtime": "workspace:*",
    "@relay/shared": "workspace:*",
    "@relay/sync": "workspace:*",
    "@types/bun": "latest",
    "drizzle-orm": "^0.38.0",
    "embedded-postgres": "18.4.0-beta.17",
    "postgres": "^3.4.9",
    "typescript": "^5.7.0",
    "yjs": "^13.6.32"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
